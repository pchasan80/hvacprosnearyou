# Environment variables (do NOT commit this file to source control)
RECAPTCHA_SECRET=123abc
IPINFO_ACCESS_TOKEN=123abc
# SMTP settings for PHPMailer
SMTP_HOST=smtp.gmail.com
SMTP_USERNAME=example@domain.com
SMTP_PASSWORD=123abc
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SET_FROM_EMAIL=noreply@domain.com
SET_FROM_NAME="Example Name"
ADD_ADDRESS=example@domain.com
CC_ADDRESSES=example1@domain.com,example2@domain.com
# ALLOWED ORIGINS
ALLOWED_ORIGINS=http://localhost:8080

# Optional: Cloudflare KV settings for centralized SMTP credentials
# If configured, SMTP_USERNAME and SMTP_PASSWORD are read from KV keys
# with the same names (or prefixed with CF_KV_KEY_PREFIX).
CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
CF_API_TOKEN=
CF_KV_KEY_PREFIX=
CF_API_TIMEOUT=5